# Local settings for the ProctorCode API. Copy this file to backend/.env and fill it in.
# Never commit a real .env file.

PORT=4000

# Random secret, 32+ characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=

# Your admin account, created (or updated) when the server starts.
# In production the password must be 12+ characters and not a common one.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# Public demo: "Try" buttons, read-only demo admin, no sign-up, data resets every few hours.
# DEMO_MODE=true
# DEMO_RESET_HOURS=6

# Where the SQLite file lives (default: backend/data/app.db).
# DATA_DIR=/var/data
# DB_PATH=/full/path/to/app.db

# Behind a reverse proxy? Tell Express how many hops to trust (on Render this is automatic).
# TRUST_PROXY=1
